profile_file = File.expand_path("~/.local/state/homebrew/profile")
unless File.exist?(profile_file)
  raise "Run in an interactive terminal to set the machine profile." unless $stdin.tty?
  FileUtils.mkdir_p(File.dirname(profile_file))
  $stderr.print "Is this a work machine? [y/N] "
  answer = $stdin.getch(intr: true).tap { $stderr.puts it.strip }
  File.write(profile_file, answer.casecmp?("y") ? "work" : "personal")
end

if File.read(profile_file).strip == "work"
  # Open-source GitLab command-line tool
  brew "glab"
  # App to build and share containerised applications and microservices
  cask "docker-desktop"
  # Team communication and collaboration software
  cask "slack"
  # Remote access and connectivity software focused on security
  cask "teamviewer"
  # Native desktop client for WhatsApp
  cask "whatsapp"
end

# Like neofetch, but much faster because written mostly in C
