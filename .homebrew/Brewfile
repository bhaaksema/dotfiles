profile_file = File.expand_path("~/.local/state/homebrew/profile")
unless File.exist?(profile_file)
  raise "Run in an interactive terminal to set the machine profile." unless $stdin.tty?
  FileUtils.mkdir_p(File.dirname(profile_file))
  $stderr.print "Is this a work machine? [y/N] "
  answer = $stdin.getch(intr: true).tap { $stderr.puts it.strip }
  File.write(profile_file, answer.casecmp?("y") ? "work" : "personal")
end

if File.read(profile_file).strip == "personal"
  cask "iloader"
  cask "raspberry-pi-imager"
  cask "spotify"
else
  brew "glab"
  brew "qemu"
  cask "docker-desktop"
  cask "slack"
  cask "teamviewer"
  cask "whatsapp"
end

brew "fastfetch"
brew "fish"
