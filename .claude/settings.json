{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "agentPushNotifEnabled": false
}
